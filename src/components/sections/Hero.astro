---
/**
 * 00 — Hero, "the first hit".
 * Capas (de atrás hacia adelante):
 *   0 atmósfera WebGL (global) · 1 textura · 2 fotografía · 3 tipografía
 *   4 grano (global) · 5 UI (metadata, indicador de scroll)
 * Cada capa reacciona distinto al scroll (ver lib/animations/hero.ts).
 */
import { siteData } from '@/data/site';
import Photo from '@/components/ui/Photo.astro';

const { band, photos, meta } = siteData;
const [first, second] = band.nameParts;
---

<section id="inicio" class="hero" data-section="inicio" data-section-index="00" data-section-label="Inicio" data-atmosphere="1" aria-labelledby="hero-title" data-hero>
  <div class="hero__texture" aria-hidden="true" data-hero-texture></div>

  <div class="hero__media" data-hero-media>
    <Photo
      photo={photos.hero}
      sizes="(min-width: 64rem) 32vw, (min-width: 48rem) 52vw, 78vw"
      priority
      caption={false}
      class="hero__photo"
    />
  </div>

  <h1 id="hero-title" class="hero__title t-display" aria-label={band.name} data-hero-title>
    <span class="hero__line hero__line--first" data-hero-line="0">
      <span class="hero__line-inner">{first}</span>
    </span>
    <span class="hero__line hero__line--second" data-hero-line="1">
      <span class="hero__line-inner">{second}</span>
    </span>
  </h1>

  <p class="hero__tagline t-subtitle" data-hero-meta>{band.tagline}</p>

  <p class="hero__fig t-micro" data-hero-meta>
    <span class="t-num">Fig. 00</span>
    <span>{photos.hero.caption}</span>
    <span>En vivo</span>
  </p>

  <p class="hero__vertical t-micro t-vertical" aria-hidden="true" data-hero-meta>
    {meta.description}
  </p>

  <a href="#banda" class="hero__scroll t-meta" data-hero-scroll data-nav-link="banda">
    <span>Scroll</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    block-size: 100svh;
    min-block-size: 34rem;
    overflow: clip;
    isolation: isolate;
  }

  /* Capa 1: textura de escaneo + caída a negro hacia la siguiente escena. */
  .hero__texture {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, transparent 55%, rgb(11 1 1 / 0.7) 100%),
      repeating-linear-gradient(to bottom, rgb(232 228 220 / 0.025) 0 1px, transparent 1px 4px);
  }

  /* Capa 2: fotografía en formato retrato, desplazada del centro. */
  .hero__media {
    position: absolute;
    inset-block-start: calc(var(--nav-height) + 4svh);
    inset-inline: 0;
    margin-inline: auto;
    inline-size: min(84vw, 28rem, 56svh);
    will-change: transform;
  }

  .hero__media :global(.photo__frame) {
    /* La foto se funde con el humo hacia abajo. */
    mask-image: linear-gradient(to bottom, black 62%, transparent 100%);
  }

  /* Capa 3: el nombre, dominante, cruzando la foto. */
  .hero__title {
    position: absolute;
    inset-inline: var(--gutter);
    inset-block-end: calc(5.5svh + 2.5rem);
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .hero__line {
    display: block;
    overflow: clip;
    /* Aire para los rasgos que sobresalen de la línea al animar. */
    padding-block: 0.04em;
    margin-block: -0.04em;
  }

  .hero__line-inner {
    display: block;
  }

  /* Ancho completo + alineación de texto: la caja no depende de la métrica
     de la fuente (sin layout shift cuando llega Archivo). */
  .hero__line--second {
    text-align: end;
  }

  .motion .hero__line-inner {
    transform: translateY(135%);
  }

  /* Capa 5: UI y metadata. */
  .hero__tagline {
    position: absolute;
    inset-inline-start: var(--gutter);
    inset-block-start: calc(var(--nav-height) + 2svh);
    max-inline-size: 7ch;
    font-stretch: 75%;
    font-weight: 500;
    line-height: 1;
  }

  .hero__fig {
    position: absolute;
    inset-inline-end: var(--gutter);
    inset-block-start: calc(var(--nav-height) + 2svh);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2em;
  }

  .hero__vertical {
    display: none;
  }

  .hero__scroll {
    position: absolute;
    inset-inline-end: var(--gutter);
    inset-block-end: 2.5svh;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-bone);
  }

  .hero__scroll-line {
    inline-size: 3rem;
    block-size: 1px;
    background: currentColor;
    transform-origin: left;
    animation: scroll-cue 2.4s var(--ease-in-out) infinite;
  }

  @keyframes scroll-cue {
    0% { transform: scaleX(0); transform-origin: left; }
    45% { transform: scaleX(1); transform-origin: left; }
    55% { transform: scaleX(1); transform-origin: right; }
    100% { transform: scaleX(0); transform-origin: right; }
  }

  .motion [data-hero-meta],
  .motion .hero__scroll {
    opacity: 0;
  }

  @media (min-width: 48rem) {
    .hero__media {
      inset-inline: auto 12vw;
      inline-size: min(48vw, 28rem, 56svh);
    }

    .hero__tagline {
      inset-block-start: calc(var(--nav-height) + 5svh);
    }
  }

  @media (min-width: 64rem) {
    .hero__media {
      inset-block-start: 7svh;
      inset-inline-end: 16vw;
      inline-size: min(32vw, 34rem, 60svh);
    }

    .hero__title {
      inset-block-end: 6svh;
    }

    .hero__fig {
      inset-block-start: calc(var(--nav-height) + 5svh);
    }

    /* Físicas: con writing-mode vertical las propiedades lógicas rotan. */
    .hero__vertical {
      display: block;
      position: absolute;
      left: calc(var(--gutter) * 0.3);
      top: 50%;
      translate: 0 -50%;
    }

    .hero__scroll {
      inset-block-end: 3svh;
    }
  }
</style>
