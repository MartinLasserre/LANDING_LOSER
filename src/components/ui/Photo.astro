---
/**
 * Fotografía: <picture> optimizado (WebP + JPG) con dimensiones intrínsecas
 * (sin CLS). La <figure> es el contenedor que usa el motion system
 * (reveal con recorte, cuadros del archivo).
 */
import { Picture } from 'astro:assets';
import type { Photo } from '@/types/content';

interface Props {
  photo: Photo;
  sizes: string;
  priority?: boolean;
  class?: string;
  /** Atributos data-* para el motion system. */
  [key: `data-${string}`]: string | boolean | undefined;
}

const { photo, sizes, priority = false, class: className, ...rest } = Astro.props;
---

<figure class:list={['photo', className]} {...rest}>
  <div class="photo__frame">
    <Picture
      src={photo.src}
      alt={photo.alt}
      widths={[360, 520, photo.src.width]}
      sizes={sizes}
      formats={['webp']}
      quality={78}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'auto' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="photo__img"
      style={photo.focus ? `object-position: ${photo.focus}` : undefined}
    />
  </div>
</figure>

<style>
  .photo {
    position: relative;
  }

  .photo__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--photo-ratio, 2 / 3);
    background: var(--color-oxblood);
  }

  .photo__frame :global(picture),
  .photo__frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .photo__frame :global(img) {
    object-fit: cover;
    filter: contrast(1.08) saturate(1.05);
  }
</style>
