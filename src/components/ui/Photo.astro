---
/**
 * Fotografía editorial: <picture> optimizado (AVIF/WebP + JPG) con
 * dimensiones intrínsecas (sin CLS) y pie con metadata real.
 * Los campos `null` de la foto (año, lugar, crédito) simplemente no se muestran.
 */
import { Picture } from 'astro:assets';
import type { Photo } from '@/types/content';

interface Props {
  photo: Photo;
  /** Numeración editorial, p. ej. "01". */
  figure?: string;
  sizes: string;
  priority?: boolean;
  caption?: boolean;
  class?: string;
  /** Atributos data-* para el motion system. */
  [key: `data-${string}`]: string | boolean | undefined;
}

const { photo, figure, sizes, priority = false, caption = true, class: className, ...rest } = Astro.props;
const details = [photo.year, photo.location].filter((v): v is string => v !== null);
---

<figure class:list={['photo', className]} {...rest}>
  <div class="photo__frame">
    <Picture
      src={photo.src}
      alt={photo.alt}
      widths={[360, 520, photo.src.width]}
      sizes={sizes}
      formats={['webp']}
      quality={78}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'auto' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="photo__img"
      style={photo.focus ? `object-position: ${photo.focus}` : undefined}
    />
  </div>
  {
    caption && (
      <figcaption class="photo__caption t-micro">
        {figure && <span class="t-num">Fig. {figure}</span>}
        <span>{photo.caption}</span>
        {details.map((d) => <span>{d}</span>)}
        {photo.credit && <span>Foto: {photo.credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .photo {
    position: relative;
  }

  .photo__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--photo-ratio, 2 / 3);
    background: var(--color-oxblood);
  }

  .photo__frame :global(picture),
  .photo__frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .photo__frame :global(img) {
    object-fit: cover;
    filter: contrast(1.08) saturate(1.05);
  }

  .photo__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em 1.2em;
    margin-block-start: var(--space-2xs);
  }
</style>
